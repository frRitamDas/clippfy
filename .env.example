SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-key
# Optional free-tier captions. Server-side only. No paid fallback is used.
TRANSCRIPTION_PROVIDER=groq
GROQ_API_KEY=
# Optional paid provider: explicitly set TRANSCRIPTION_PROVIDER=openai to enable.
OPENAI_API_KEY=
PORT=3000
# Optional local override for an installed yt-dlp executable (absolute path).
# Vercel uses the verified standalone worker installed during build.
# YTDLP_PATH=/usr/local/bin/yt-dlp
# Optional HTTPS base URL for the separate worker container; never a browser localhost URL.
# Set on Vercel only after deploying worker/Dockerfile to a host you control.
# DOWNLOAD_WORKER_URL=https://your-worker.example.com/
# Optional source-duration cap in seconds. Unset = no application duration cap.
# This does not change Vercel's 300-second execution ceiling or the 50-MB upload limit.
# MAX_SOURCE_SECONDS=7200
